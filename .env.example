# Copy to .env and fill in. .env is ignored by git.

# The domain Caddy serves, with an A record pointing at this machine.
WHATNOW_DOMAIN=whatnow.example.com

# From the Google OAuth client (docs/hosting.md, section 5). Its redirect URI must be
# https://<WHATNOW_DOMAIN>/auth/google/callback
WHATNOW_GOOGLE_CLIENT_ID=
WHATNOW_GOOGLE_CLIENT_SECRET=

# Encrypts users' stored secrets: `openssl rand -base64 32`. Keep a copy somewhere safe; losing it
# makes every user's saved API keys unreadable.
WHATNOW_SEAL_KEY=

# Optional.
#WHATNOW_MAX_USERS=100
#WHATNOW_VERSION=dev
